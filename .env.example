# La analítica permanece desactivada si esta variable está vacía.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# API HTTPS de Resend para el formulario de contacto
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO=info@molpo.ar

# Módulo de soporte (tickets de clientes)
DATABASE_URL=postgres://usuario:clave@host:5432/basedatos
SOPORTE_CLIENTES=token1:Nombre Cliente,token2:Otro Cliente
SOPORTE_ADMIN_TOKEN=un-token-largo-y-aleatorio

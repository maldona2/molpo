# La analítica permanece desactivada si esta variable está vacía.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# API HTTPS de Resend para el formulario de contacto
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO=info@molpo.ar

# App privada (app.molpo.ar): tickets, tablero, clientes y feedback
DATABASE_URL=postgres://usuario:clave@host:5432/basedatos
# Emails con acceso de admin, separados por coma. Es el único lugar donde se
# decide quién es admin: el rol no vive en la base.
ADMIN_EMAILS=vos@molpo.ar
# URL pública del subdominio, para armar los links de los mails.
APP_URL=https://app.molpo.ar
